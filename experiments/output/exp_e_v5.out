leverage                          0.21      2.4x          0.066          0.123           +0.01
ridge                             0.17      2.0x          0.070          0.129           +0.01
cur_residual                      0.21      2.5x          0.066          0.130           +0.01
supersede+tfidf                   0.07      0.8x          0.046          0.059           -0.00
